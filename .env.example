# ==============================================================================
# Cotton Guard AI Inference Backend - Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DOMAIN=localhost

# Persistent Storage & Model Paths
SQLITE_DB_PATH=/var/data/advisory.db
ONNX_MODEL_PATH=ml/models/cotton_guard_model.onnx

# Cryptographic Session Security (Generate a strong 256-bit random key)
# e.g., openssl rand -hex 32
COTTON_GUARD_SECRET_KEY=replace-with-a-secure-random-256-bit-secret-key

# Google OAuth 2.0 Web Application Client ID (Audience for ID token verification)
# Created in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com

# Administrator Control Plane (Designated Admin Authorization)
ADMIN_EMAIL=admin@cottonguard.org
ADMIN_API_KEY=replace-with-a-secure-admin-api-key

# Upload & Rate Limiting Guardrails
MAX_UPLOAD_SIZE_MB=15
